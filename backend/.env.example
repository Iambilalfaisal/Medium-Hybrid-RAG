# Postgres (pgvector extension must be enabled on this database)
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/medium_rag

# Gemini (embeddings always; primary generation provider)
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_RPM=5

# OpenRouter (fallback generation provider only — no embeddings)
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.2:free
PROVIDER_FAILOVER_COOLDOWN_SECONDS=300

# Cohere Rerank
COHERE_API_KEY=
COHERE_EVAL_RPM=5
RERANK_ABSTAIN_THRESHOLD=0.3

# Scraping
SCRAPE_CONCURRENCY=2
SCRAPE_RATE_LIMIT_DELAY_MS=1500
SCRAPE_TIMEOUT_SECONDS=15
MIN_TEXT_LENGTH=500

# Chunking
CHILD_CHUNK_SIZE=512
PARENT_CHUNK_SIZE=2048
CHILD_CHUNK_OVERLAP=128

# Local artifacts
BM25_INDEX_PATH=artifacts/bm25_index.pkl
SCRAPE_CACHE_PATH=artifacts/scrape_cache.sqlite3
